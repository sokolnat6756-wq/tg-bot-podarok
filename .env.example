# Токен бота от @BotFather. Не публикуйте реальные значения.
BOT_TOKEN=вставьте_токен_сюда

# Ключ OpenAI для текста и открыток: https://platform.openai.com/api-keys
OPENAI_API_KEY=вставьте_ключ_openai_сюда

# Необязательно: текстовая модель (поздравления и ответы)
# OPENAI_MODEL=gpt-6-luna

# Необязательно: модель картинок (по умолчанию gpt-image-2).
# Доступ конкретной модели к вашему аккаунту нужно проверить у OpenAI.
# Если gpt-image-2 недоступна, попробуйте например:
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_MODEL=gpt-image-2

# Размер запроса к Images API (вертикальный портрет) и качество
# OPENAI_IMAGE_SIZE=1024x1536
# OPENAI_IMAGE_QUALITY=medium

# Итоговая открытка 9:16 после сборки (без обрезки текста)
# CARD_OUTPUT_WIDTH=1080
# CARD_OUTPUT_HEIGHT=1920

# Лимит открыток на одного пользователя за скользящий час (в памяти; 0 = без лимита)
# CARD_HOURLY_LIMIT=5

# Для Timeweb App Platform (health-check). Часто задаётся самой платформой.
# PORT=8080
