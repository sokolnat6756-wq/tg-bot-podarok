# Скопируйте в .env НА СЕРВЕРЕ (не в GitHub).
# BOT_TOKEN и OPENAI_API_KEY обязательны.

BOT_TOKEN=вставьте_токен_сюда
OPENAI_API_KEY=вставьте_ключ_openai_сюда

# Необязательно:
# OPENAI_MODEL=gpt-6-luna
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1024x1536
# OPENAI_IMAGE_QUALITY=medium
# CARD_OUTPUT_WIDTH=1080
# CARD_OUTPUT_HEIGHT=1920
# CARD_USER_LIMIT=2
# PORT=8080
